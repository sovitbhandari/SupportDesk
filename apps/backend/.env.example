PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/supportdesk
APP_DATABASE_URL=postgresql://app_user:app_user_password@localhost:55432/supportdesk
REDIS_URL=redis://localhost:6379
# Comma-separated if needed. If unset, allows both http://localhost:5173 and http://127.0.0.1:5173
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=zl_refresh
SMTP_HOST=localhost
SMTP_PORT=1025
FROM_EMAIL=support@supportdesk.local
OUTBOX_DISPATCH_INTERVAL_MS=5000
OUTBOX_DISPATCH_BATCH_SIZE=10
OUTBOX_LEASE_SECONDS=30
OUTBOX_MAX_DISPATCH_ATTEMPTS=10
SHUTDOWN_GRACE_MS=10000
